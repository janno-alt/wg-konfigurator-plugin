# Composer
/vendor/
# composer.lock wird committet, damit jeder Build dieselben Paketversionen nutzt.

# Node / Vite
node_modules/
dist/
assets/quiz-app/node_modules/
assets/quiz-app/dist/
.cache/

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Build artifacts that ARE committed for distribution
# (we DO commit /assets/quiz-app/build/ — see below)
!assets/quiz-app/build/

# Secrets — never commit
.env*
*.pem
*.key
wp-config-local.php

# Generated PDFs (runtime)
uploads/
storage/
*.pdf
!docs/*.pdf

# Logs
*.log

# Release-Zips (entstehen in der GitHub Action)
*.zip
